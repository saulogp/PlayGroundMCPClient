@page "/mcp-servers"
@using System.Text.Json
@inject McpServerRegistry Registry
@inject McpClientPool Pool
@inject TokenStore TokenStore
@inject OAuthClient OAuthClient
@inject OAuthState OAuthState
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@implements IDisposable

<PageTitle>MCP Servers - Playground MCP</PageTitle>

<MudStack Row Class="mb-2" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.h5">MCP Servers</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="OpenAddDialog">Adicionar</MudButton>
</MudStack>

<MudTable Items="_servers" Dense="true" Hover="true" Bordered="true">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>URL</MudTh>
        <MudTh>Origem</MudTh>
        <MudTh>Auth</MudTh>
        <MudTh>Default</MudTh>
        <MudTh>Acoes</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Url</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small"
                     Color="@(context.Source == McpServerSource.File ? Color.Info : Color.Secondary)">
                @context.Source
            </MudChip>
        </MudTd>
        <MudTd>
            @{
                var (label, color) = AuthChip(context);
            }
            <MudChip T="string" Size="Size.Small" Color="@color">@label</MudChip>
        </MudTd>
        <MudTd>@(context.EnabledByDefault ? "Sim" : "Nao")</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" OnClick="@(() => InspectAsync(context))">Inspect</MudButton>
            <MudButton Size="Size.Small" OnClick="@(() => TestAsync(context))">Test</MudButton>
            @if (context.AuthMode == McpAuthMode.OAuth)
            {
                <MudButton Size="Size.Small"
                           OnClick="@(() => ReauthAsync(context))">Re-autenticar</MudButton>
                <MudButton Size="Size.Small"
                           OnClick="@(() => ClearTokensAsync(context))">Limpar tokens</MudButton>
            }
            @if (context.Source == McpServerSource.Ui)
            {
                <MudButton Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => Remove(context.Name))">Remove</MudButton>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<McpServerConfig> _servers = Array.Empty<McpServerConfig>();

    protected override void OnInitialized()
    {
        _servers = Registry.GetAll();
        Registry.Changed += Reload;
        TokenStore.TokenChanged += OnTokenChanged;
        OAuthState.ReauthRequired += OnAuthStateChanged;
        OAuthState.ReauthCleared += OnAuthStateChanged;
    }

    private void Reload()
    {
        _servers = Registry.GetAll();
        InvokeAsync(StateHasChanged);
    }

    private void OnTokenChanged(string _) => InvokeAsync(StateHasChanged);
    private void OnAuthStateChanged(string _) => InvokeAsync(StateHasChanged);

    private (string Label, Color Color) AuthChip(McpServerConfig cfg)
    {
        switch (cfg.AuthMode)
        {
            case McpAuthMode.None:
                return ("Anonimo", Color.Default);
            case McpAuthMode.BearerStatic:
                return ("Bearer", Color.Info);
            case McpAuthMode.OAuth:
                if (OAuthState.RequiresReauth(cfg.Name))
                    return ("OAuth - reauth", Color.Warning);
                var token = TokenStore.Get(cfg.Name);
                if (token is null) return ("OAuth - sem token", Color.Warning);
                if (token.ExpiresAt is { } exp && exp < DateTimeOffset.UtcNow)
                    return ("OAuth expirado", Color.Warning);
                return ("OAuth OK", Color.Success);
            default:
                return (cfg.AuthMode.ToString(), Color.Default);
        }
    }

    private async Task OpenAddDialog()
    {
        var dialog = await Dialog.ShowAsync<AddServerDialog>("Adicionar MCP server");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: McpServerConfig cfg })
        {
            Registry.AddOrUpdate(cfg);
            Snackbar.Add($"Server '{cfg.Name}' adicionado", Severity.Success);
        }
    }

    private void Remove(string name)
    {
        if (Registry.Remove(name))
        {
            TokenStore.Remove(name);
            Snackbar.Add($"Server '{name}' removido", Severity.Info);
        }
    }

    private async Task TestAsync(McpServerConfig cfg)
    {
        try
        {
            var client = await Pool.GetAsync(cfg);
            var info = client.ServerInfo;
            Snackbar.Add($"OK: {info?.Name} v{info?.Version}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Falha: {ex.Message}", Severity.Error);
        }
    }

    private async Task InspectAsync(McpServerConfig cfg)
    {
        var parameters = new DialogParameters { ["Config"] = cfg };
        await Dialog.ShowAsync<InspectorDialog>($"Inspector: {cfg.Name}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task ReauthAsync(McpServerConfig cfg)
    {
        try
        {
            var token = await OAuthClient.AuthorizeAsync(cfg);
            TokenStore.Save(cfg.Name, token);
            OAuthState.ClearRequiresReauth(cfg.Name);
            await Pool.InvalidateOneAsync(cfg.Name);
            Snackbar.Add($"'{cfg.Name}' autenticado", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Falha OAuth: {ex.Message}", Severity.Error);
        }
    }

    private async Task ClearTokensAsync(McpServerConfig cfg)
    {
        TokenStore.Remove(cfg.Name);
        OAuthState.ClearRequiresReauth(cfg.Name);
        await Pool.InvalidateOneAsync(cfg.Name);
        Snackbar.Add($"Tokens de '{cfg.Name}' removidos", Severity.Info);
    }

    public void Dispose()
    {
        Registry.Changed -= Reload;
        TokenStore.TokenChanged -= OnTokenChanged;
        OAuthState.ReauthRequired -= OnAuthStateChanged;
        OAuthState.ReauthCleared -= OnAuthStateChanged;
    }
}
