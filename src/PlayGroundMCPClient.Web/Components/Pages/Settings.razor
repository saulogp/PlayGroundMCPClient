@page "/settings"
@using Microsoft.SemanticKernel
@using Microsoft.SemanticKernel.ChatCompletion
@using Microsoft.SemanticKernel.Connectors.OpenAI
@inject LlmStore Store
@inject ISnackbar Snackbar

<PageTitle>Settings - Playground MCP</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">LLM (OpenAI)</MudText>

<MudPaper Class="pa-4" Outlined="true" Style="max-width: 720px;">
    <MudStack Spacing="3">
        <MudTextField @bind-Value="_model"
                      Label="Model"
                      HelperText="Ex.: gpt-4o, gpt-4o-mini, gpt-4.1"
                      Variant="Variant.Outlined"
                      Required="true" />

        <MudTextField @bind-Value="_apiKey"
                      Label="API Key"
                      HelperText="Sua key da OpenAI (sk-...)"
                      InputType="@(_showKey ? InputType.Text : InputType.Password)"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _showKey = !_showKey)"
                      Required="true" />

        <MudStack Row Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Save">Salvar</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Bolt"
                       OnClick="TestConnection"
                       Disabled="_testing">
                @(_testing ? "Testando..." : "Testar conexao")
            </MudButton>
            <MudSpacer />
            @if (_status is not null)
            {
                <MudChip T="string" Color="@(_statusOk ? Color.Success : Color.Error)" Size="Size.Small">
                    @_status
                </MudChip>
            }
        </MudStack>

        <MudAlert Severity="Severity.Info" Dense="true">
            Os valores ficam em <code>llm.user.json</code> (gitignored).
            Voce tambem pode definir via <code>appsettings.json</code> (secao <code>Llm</code>)
            ou variaveis de ambiente <code>Llm__Model</code> / <code>Llm__ApiKey</code>.
        </MudAlert>
    </MudStack>
</MudPaper>

@code {
    private string _model = "";
    private string _apiKey = "";
    private bool _showKey;
    private bool _testing;
    private string? _status;
    private bool _statusOk;

    protected override void OnInitialized()
    {
        var c = Store.Current;
        _model = c.Model;
        _apiKey = c.ApiKey;
    }

    private void Save()
    {
        Store.Update(new LlmOptions
        {
            Model = _model.Trim(),
            ApiKey = _apiKey.Trim()
        });
        Snackbar.Add("Configuracao salva", Severity.Success);
    }

    private async Task TestConnection()
    {
        if (string.IsNullOrWhiteSpace(_model) || string.IsNullOrWhiteSpace(_apiKey))
        {
            _status = "Preencha model e key";
            _statusOk = false;
            return;
        }

        _testing = true;
        _status = null;
        StateHasChanged();

        try
        {
            var builder = Kernel.CreateBuilder();
            builder.AddOpenAIChatCompletion(_model.Trim(), _apiKey.Trim());
            var kernel = builder.Build();
            var chat = kernel.GetRequiredService<IChatCompletionService>();
            var history = new ChatHistory();
            history.AddUserMessage("ping");
            var resp = await chat.GetChatMessageContentAsync(history);
            _status = $"OK: {Truncate(resp.Content, 40)}";
            _statusOk = true;
        }
        catch (Exception ex)
        {
            _status = $"Falha: {Truncate(ex.Message, 80)}";
            _statusOk = false;
        }
        finally
        {
            _testing = false;
        }
    }

    private static string Truncate(string? s, int max) =>
        s is null ? "" : (s.Length <= max ? s : s[..max] + "...");
}
