@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleNav" />
        <MudText Typo="Typo.h6" Class="ml-2">Playground MCP</MudText>
        <MudSpacer />
        <MudTooltip Text="Protocol Logs">
            <MudIconButton Icon="@Icons.Material.Filled.Terminal"
                           Color="Color.Inherit"
                           OnClick="@ToggleLogs" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_navOpen" Variant="DrawerVariant.Mini" OpenMiniOnHover="true" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudDrawer @bind-Open="_logsOpen" Anchor="Anchor.End" Variant="DrawerVariant.Temporary"
               Elevation="2" Width="520px">
        <ProtocolLogPanel />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _navOpen = true;
    private bool _logsOpen;

    private void ToggleNav() => _navOpen = !_navOpen;
    private void ToggleLogs() => _logsOpen = !_logsOpen;
}
